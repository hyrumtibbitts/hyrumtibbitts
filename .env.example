# ---- Supabase ----
# Project URL and keys from your Supabase project settings → API.
# Use the SAME project where you ran supabase/migrations/0001_init.sql.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Used by API routes to store audio,
# persist fragments, and upsert assembled reports. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Anthropic (report assembly) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Transcription ----
# Primary: OpenAI Whisper. Reuse your existing OpenAI key.
OPENAI_API_KEY=sk-...
# Optional model override (defaults to whisper-1):
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# Alternative engine: Deepgram (used only if OPENAI_API_KEY is unset).
# Leave blank if using OpenAI.
DEEPGRAM_API_KEY=
