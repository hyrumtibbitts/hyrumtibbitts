# ---- Supabase ----
# Project URL and keys from your Supabase project settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Used by API routes to store audio,
# persist fragments, and upsert assembled reports. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Anthropic (report assembly) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Deepgram (transcription, with domain keyword boosting) ----
# Optional in dev: if unset, audio is still stored and the capture loop works;
# transcripts are left blank for review. Set it for real transcription.
DEEPGRAM_API_KEY=your-deepgram-key
